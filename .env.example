# Token de verificación del webhook (lo defines tú, debe coincidir con el dashboard de Meta)
VERIFY_TOKEN=mi_token

# Token de acceso de WhatsApp Cloud API (de Meta for Developers)
WHATSAPP_TOKEN=

# ID del número de teléfono de WhatsApp Business
PHONE_ID=

# Host de Ollama (opcional; por defecto localhost:11434)
OLLAMA_HOST=http://localhost:11434